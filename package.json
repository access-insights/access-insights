{
  "name": "access-insights",
  "private": true,
  "scripts": {
    "run": "python3 -m http.server 8080",
    "build": "rm -rf dist && mkdir -p dist/images/team && cp index.html dist/ && cp images/logo.svg dist/images/ && cp images/team/*.png dist/images/team/",
    "test": "playwright test",
    "test:a11y": "playwright test tests/axe-accessibility.spec.ts",
    "test:smoke": "playwright test tests/accessibility-smoke.spec.ts",
    "screen-reader:validate": "screen-reader-harness validate --root .",
    "screen-reader:prepare:nvda": "screen-reader-harness prepare --root . --reader nvda --suite critical --application access-insights-website",
    "screen-reader:prepare:narrator": "screen-reader-harness prepare --root . --reader narrator --suite critical --application access-insights-website",
    "test:screen-reader:contracts": "node --test tests/screen-reader/contracts.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@access-insights/screen-reader-harness": "github:access-insights/screen-reader-harness#80df5f6fe1585d946844988b1e47120459de8179",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.61.1"
  },
  "overrides": {
    "playwright-core": "1.61.1"
  }
}
