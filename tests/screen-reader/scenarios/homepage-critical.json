    {
      "id": "find-team-heading",
      "action": "next_heading",
      "expect": {
        "role": "heading",
        "nameContains": "Genuine expertise in accessibility"
      }
    },
    {
      "id": "find-numbers-heading",
      "action": "next_heading",
      "expect": {
        "role": "heading",
        "nameContains": "By the numbers"
      }
    },
    {
      "id": "find-community-heading",
      "action": "next_heading",
      "expect": {
        "role": "heading",
        "nameContains": "Help shape what’s next"
      }
    },
    {
      "id": "find-partner-heading",
      "action": "next_heading",
      "expect": {
        "role": "heading",
        "nameContains": "Build the future with us"
      }
    }
